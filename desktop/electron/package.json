{
  "name": "ipcheck-desktop",
  "version": "0.1.0",
  "description": "Desktop shell for IP Check",
  "main": "main.js",
  "author": "louisgreen0726",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack:linux": "electron-builder --linux dir",
    "dist:linux": "electron-builder --linux AppImage deb"
  },
  "build": {
    "appId": "com.louisgreen.ipcheck",
    "productName": "IP Check",
    "artifactName": "ip-check-${version}-${arch}.${ext}",
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../dist/desktop/ipcheck",
        "to": "ipcheck/ipcheck"
      }
    ],
    "linux": {
      "category": "Network",
      "executableName": "ip-check",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12"
  }
}
